{
  "name": "usage-bars",
  "version": "0.4.0",
  "description": "Claude Code Desktop の入力欄の上に context・5h・7d の使用率をバーで常時出す",
  "author": { "name": "tanmen", "url": "https://github.com/tanmen" },
  "homepage": "https://github.com/tanmen/claude-tanmen-plugins/tree/main/plugins/usage-bars",
  "repository": "https://github.com/tanmen/claude-tanmen-plugins",
  "license": "MIT",
  "keywords": ["usage", "rate-limit", "context", "desktop"],
  "types": "./types/index.d.ts",
  "userConfig": {
    "size": {
      "type": "string",
      "title": "バーの大きさ",
      "description": "compact はバー 19px（帯 40px）、regular はバー 26px（帯 47px）",
      "options": ["compact", "regular"],
      "default": "compact"
    }
  }
}
